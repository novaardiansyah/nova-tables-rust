{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Tables",
  "version": "2.2.2",
  "identifier": "com.nova.tables",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nova Tables",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nova Tables",
    "copyright": "Copyright © 2026 Nova Tables",
    "shortDescription": "A modern desktop SQL client for Microsoft SQL Server",
    "longDescription": "A modern desktop SQL client for Microsoft SQL Server built with Tauri and React.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "signCommand": {
        "cmd": "node",
        "args": [
          "scripts/sign-windows.cjs",
          "%1"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {}
}
